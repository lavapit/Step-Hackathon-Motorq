# FleetGuard AI Environment Configuration
# Synthetic passwords & local development defaults

# Profile: dev | laptop | full
RUN_PROFILE=laptop
COMPOSE_PROFILES=core

# PostgreSQL 16 + pgvector
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=fleetguard
POSTGRES_USER=fleetguard_app
POSTGRES_PASSWORD=fleetguard_secret_pass
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_admin_pass

# ClickHouse 24.x
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB=fleetguard
CLICKHOUSE_USER=fleetguard_app
CLICKHOUSE_PASSWORD=clickhouse_secret_pass

# Redis 7
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_pass

# Redpanda (Kafka API)
KAFKA_BROKERS=redpanda:9092
KAFKA_EXTERNAL_BROKERS=localhost:19092

# MinIO (S3 API)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_secret_pass
MINIO_BUCKET_COLD=telemetry-cold
MINIO_BUCKET_MODELS=ml-models

# Keycloak OIDC
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=fleetguard
KEYCLOAK_CLIENT_ID=fleetguard-web
KEYCLOAK_CLIENT_SECRET=fleetguard-web-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_secret_pass

# HashiCorp Vault
VAULT_ADDR=http://vault:8200
VAULT_DEV_ROOT_TOKEN_ID=vault-root-token-fleetguard

# OpenTelemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
LOKI_PORT=3100
TEMPO_PORT=3200

# App ports
GATEWAY_PORT=8443
API_PORT=8000
WEB_PORT=3000

# Synthetic Seed Settings
SEED_VEHICLES=100000
SEED_DAYS=7
SEED_RANDOM_STATE=42

# LLM Configuration (Mock LLM by default for deterministic test/demo)
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=mock-key
